                </span>
                <span className="text-[10px] text-slate-500 -mt-1 font-medium">
                  سامانه پیشرفته تایپ ده‌انگشتی
                </span>
              </div>
            </Link>

            {/* Live active room pulse */}
            <div className="hidden lg:flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-xs text-emerald-700 font-medium">
              <span className="relative flex h-2 w-2">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span className="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span>۲۱۴ تایپیست فعال در رقابت</span>
            </div>
          </div>

          {/* Desktop Mega Navigation */}
          <nav className="hidden md:flex items-center gap-1">
